rules_version = '2';

// Règles de sécurité Firestore pour Casino Chibouk
// À coller dans : Console Firebase → Firestore Database → Règles → Publier
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = compte présent dans la collection « admins » (document dont l'ID est son uid, créé à la main)
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /users/{uid} {
      // Tout joueur connecté peut lire les profils (nécessaire pour le classement)
      allow read: if request.auth != null;

      // Création de son propre profil uniquement, avec le solde de départ
      // (si tu changes START_BALANCE dans js/config.js, change aussi 1000 ici)
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.balance == 1000
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() >= 3
        && request.resource.data.pseudo.size() <= 16;

      // Mise à jour de son propre profil uniquement, pseudo non modifiable, solde plausible, photo et bio de taille raisonnable
      // (avatar = petite image encodée en texte, bio = 160 caractères max côté site)
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.pseudo == resource.data.pseudo
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= 1000000000000000
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 40000))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 200))
        // compte suspendu : plus aucune écriture ; et le joueur ne peut toucher ni à sa suspension ni aux corrections d'un admin
        // (adminRev change à chaque correction : un onglet ouvert avant la correction voit sa sauvegarde refusée et se recharge)
        && resource.data.get('banned', false) != true
        && request.resource.data.get('banned', false) == resource.data.get('banned', false)
        && request.resource.data.get('banReason', '') == resource.data.get('banReason', '')
        && request.resource.data.get('adminRev', 0) == resource.data.get('adminRev', 0)
        && request.resource.data.get('adminNote', '') == resource.data.get('adminNote', '')
        && request.resource.data.get('tags', []) == resource.data.get('tags', [])
        // cadeaux de l'admin : le joueur ne peut que vider la liste après les avoir reçus
        && (request.resource.data.get('gifts', []) == resource.data.get('gifts', []) || request.resource.data.get('gifts', []).size() == 0);

      // Correction par un admin : solde, coffre, suspension, note, tags (OG CHBK…) et cadeaux uniquement, avec adminRev + 1
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'vault', 'banned', 'banReason', 'adminRev', 'adminAt', 'adminNote', 'tags', 'gifts'])
        && request.resource.data.adminRev == resource.data.get('adminRev', 0) + 1
        && request.resource.data.balance is number && request.resource.data.balance >= 0;

      allow delete: if false;
    }

    // Transferts de Brundles entre joueurs
    match /transfers/{id} {
      // On ne voit que les transferts qu'on a envoyés ou reçus
      allow read: if request.auth != null
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);

      // Création : c'est bien moi l'expéditeur, montant entier positif, destinataire existant,
      // et mon solde est débité du même montant dans la même écriture atomique
      allow create: if request.auth != null
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && request.resource.data.claimed == false
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance
           == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.balance - request.resource.data.amount;

      // Encaissement : seul le destinataire peut passer "claimed" à true, une seule fois
      allow update: if request.auth != null
        && resource.data.to == request.auth.uid
        && resource.data.claimed == false
        && request.resource.data.claimed == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimedAt']);

      allow delete: if false;
    }

    // Fil d'activité « En direct de la jungle » : chacun publie en son nom, personne ne modifie ni ne supprime
    match /feed/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind is string
        && request.resource.data.kind.size() <= 20
        && request.resource.data.at is number
        && request.resource.data.size() <= 12;
      allow update, delete: if false;
    }

    // Jackpot commun : on ne peut qu'ajouter (1 % des mises de la slot), ou le remporter (remise à zéro à son nom)
    // (10000 = JACKPOT_SEED dans js/config.js)
    match /meta/jackpot {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000000;
      allow update: if request.auth != null && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount'])
          && request.resource.data.amount > resource.data.amount
          && request.resource.data.amount - resource.data.amount <= 1000000000)
        || (request.resource.data.amount == 0
          && request.resource.data.lastWinner == request.auth.uid
          && request.resource.data.lastAmount == 10000 + resource.data.amount)
      );
      allow delete: if false;
    }

    // Palmarès des semaines : un document par semaine, créé une seule fois, jamais modifié
    match /weeks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.winnerUid is string
        && request.resource.data.profit is number;
      allow update, delete: if false;
    }

    // Admins : un document par admin, dont l'identifiant est l'uid du compte (créé à la main dans la console)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Défi de la jungle (un défi toutes les 12 min) : podium de 3 places. Une place = un document
    // « p » + créneau + « _ » + place (créneau = minutes depuis 1970 ÷ 12). Créé pendant le créneau (+ 2 min de marge,
    // heure du serveur), une seule fois, jamais modifié. La place 2 (puis 3) n'est possible que si la précédente est déjà
    // prise, et jamais deux places pour le même joueur.
    match /challenges/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.slot is int
        && request.resource.data.place is int
        && request.resource.data.place >= 1
        && request.resource.data.place <= 3
        && id == 'p' + string(request.resource.data.slot) + '_' + string(request.resource.data.place)
        && request.time.toMillis() >= request.resource.data.slot * 720000
        && request.time.toMillis() < (request.resource.data.slot + 1) * 720000 + 120000
        && request.resource.data.prize is number
        && request.resource.data.prize >= 0
        && request.resource.data.prize <= 5000000
        && request.resource.data.size() <= 12
        && (request.resource.data.place == 1
          || get(/databases/$(database)/documents/challenges/$('p' + string(request.resource.data.slot) + '_1')).data.uid != request.auth.uid)
        && (request.resource.data.place < 3
          || get(/databases/$(database)/documents/challenges/$('p' + string(request.resource.data.slot) + '_2')).data.uid != request.auth.uid);
      allow update, delete: if false;
    }

    // Chat : un message = un document. ts = heure du serveur (ordre identique sur tous les appareils), 200 caractères max.
    match /chat/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 200
        && request.resource.data.ts == request.time
        && request.resource.data.size() <= 8
        && (!('tg' in request.resource.data)
          || request.resource.data.tg == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('tags', []));
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Journal des mini-jeux : chacun écrit ses propres parties, seuls les admins lisent, personne ne modifie
    match /logs/{id} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.game is string
        && request.resource.data.game.size() <= 20
        && request.resource.data.at is number
        && request.resource.data.size() <= 20;
      allow update, delete: if false;
    }

    // Tout le reste est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
